import datetime
import pandas as pd
import numpy as np
from IPython.display import display
from facebook_business.exceptions import FacebookRequestError

# Config
START_DATE_STR        = "2024-11-1"
END_DATE_STR          = "2025-12-1"
FIRST_DAY_OF_WEEK     = "Monday"      
CAMPAIGN_NAME_CONTAINS = "UK"         
METRICS_TO_FETCH      = ["reach", "impressions", "frequency", "cpm", "spend"]


def _week_chunks(start_date: datetime.date, end_date: datetime.date, first_day_name: str):
    day_map = {'monday':0,'tuesday':1,'wednesday':2,'thursday':3,'friday':4,'saturday':5,'sunday':6}
    fd = first_day_name.lower()
    if fd not in day_map:
        raise ValueError(f"Invalid FIRST_DAY_OF_WEEK '{first_day_name}'. Choose {list(day_map)}")
    first_idx = day_map[fd]
    cur = start_date
    while cur <= end_date:
        end_of_week_idx = (first_idx - 1 + 7) % 7
        days_to_eow = (end_of_week_idx - cur.weekday() + 7) % 7
        wk_end = min(cur + datetime.timedelta(days=days_to_eow), end_date)
        yield cur, wk_end
        cur = wk_end + datetime.timedelta(days=1)

def _filtering(campaign_contains: str):
    s = str(campaign_contains or "").strip()
    if not s:
        return []
    return [{"field": "campaign.name", "operator": "CONTAIN", "value": s}]

def _insights_period(level, since, until, fields, filtering=None):
    params = {
        "level": level,
        "time_range": {"since": since, "until": until},
        "action_report_time": "impression",
    }
    if filtering:
        params["filtering"] = filtering
    rows = [dict(r) for r in account.get_insights(fields=fields, params=params)]
    return rows[0] if rows else {}

# Parse dates
start_date = datetime.datetime.strptime(START_DATE_STR, "%Y-%m-%d").date()
end_date   = datetime.datetime.strptime(END_DATE_STR,   "%Y-%m-%d").date()
if start_date > end_date:
    raise ValueError("START_DATE cannot be after END_DATE.")

print(f"Weekly incremental reach for {account.get_id()}  |  {start_date} → {end_date}  |  Week start: {FIRST_DAY_OF_WEEK}")
print("Campaign filter:", f'campaign.name CONTAIN "{CAMPAIGN_NAME_CONTAINS.strip()}"' if CAMPAIGN_NAME_CONTAINS.strip() else "(none) — whole account")

flt = _filtering(CAMPAIGN_NAME_CONTAINS)

# Fetch weekly + cumulative data
results = []
for wk_start, wk_end in _week_chunks(start_date, end_date, FIRST_DAY_OF_WEEK):
    try:
        weekly = _insights_period("account", wk_start.isoformat(), wk_end.isoformat(), METRICS_TO_FETCH, filtering=flt)
        cumulative = _insights_period("account", start_date.isoformat(), wk_end.isoformat(), ["reach"], filtering=flt)
        results.append({
            "date": wk_start.strftime("%Y-%m-%d"),
            "reach": int(float(weekly.get("reach", 0) or 0)),
            "reach_for_date": int(float(cumulative.get("reach", 0) or 0)),
            "impressions": int(float(weekly.get("impressions", 0) or 0)),
            "frequency": float(weekly.get("frequency", 0.0) or 0.0),
            "cpm": float(weekly.get("cpm", 0.0) or 0.0),
            "spend": float(weekly.get("spend", 0.0) or 0.0),
        })
    except FacebookRequestError as e:
        print(f"[API] {wk_start}→{wk_end} failed: {e}; filling zeros.")
        results.append({
            "date": wk_start.strftime("%Y-%m-%d"),
            "reach": 0, "reach_for_date": 0, "impressions": 0,
            "frequency": 0.0, "cpm": 0.0, "spend": 0.0
        })

df = pd.DataFrame(results)
if df.empty:
    print("No rows returned for the given range/filter.")
else:
    # Clean/order
    df["date"] = pd.to_datetime(df["date"])
    df = df.sort_values("date").reset_index(drop=True)

    # Weekly metrics table
    weekly_cols = ["date", "reach", "reach_for_date", "impressions", "frequency", "cpm", "spend"]
    weekly_tbl = df[weekly_cols].copy()
    styled_weekly = (
        weekly_tbl.style
        .format({
            "date": lambda d: pd.to_datetime(d).strftime("%Y-%m-%d"),
            "reach": "{:,.0f}".format,
            "reach_for_date": "{:,.0f}".format,
            "impressions": "{:,.0f}".format,
            "frequency": "{:,.2f}".format,
            "cpm": "{:,.2f}".format,
            "spend": "£{:,.2f}".format,  
        })
    )
    print("\nWeekly metrics:")
    display(styled_weekly)

    # Incremental reach breakdown (weekly)
    df_ir = df.copy()
    df_ir["incremental_reach"] = 0
    df_ir["existing_reach"] = 0
    df_ir.reset_index(drop=True, inplace=True)

    for i in range(len(df_ir)):
        wk = df_ir.at[i, "reach"]
        cum = df_ir.at[i, "reach_for_date"]
        incr = cum if i == 0 else max(0, cum - df_ir.at[i-1, "reach_for_date"])
        df_ir.at[i, "incremental_reach"] = max(0, incr)
        df_ir.at[i, "existing_reach"] = max(0, wk - incr)

    df_ir["incremental_pct"] = np.where(df_ir["reach"] > 0,
                                        (df_ir["incremental_reach"] / df_ir["reach"]) * 100, 0.0)

    incr_cols = ["date", "reach", "incremental_reach", "existing_reach", "incremental_pct"]
    incr_tbl = df_ir[incr_cols].copy()
    styled_incr = (
        incr_tbl.style
        .format({
            "date": lambda d: pd.to_datetime(d).strftime("%Y-%m-%d"),
            "reach": "{:,.0f}".format,
            "incremental_reach": "{:,.0f}".format,
            "existing_reach": "{:,.0f}".format,
            "incremental_pct": "{:,.1f}%".format,
        })
    )
    print("\nIncremental reach breakdown (per week):")
    display(styled_incr)

    # Spend summary with cumulative spend
    df_sp = df.copy()
    df_sp["cumulative_spend"] = df_sp["spend"].cumsum()
    spend_cols = ["date", "spend", "cumulative_spend"]
    spend_tbl = df_sp[spend_cols].copy()
    styled_spend = (
        spend_tbl.style
        .format({
            "date": lambda d: pd.to_datetime(d).strftime("%Y-%m-%d"),
            "spend": "£{:,.2f}".format,
            "cumulative_spend": "£{:,.2f}".format,
        })
    )
    print("\nWeekly spend (with cumulative):")
    display(styled_spend)

    # Create raw frames
    weekly_metrics_df = weekly_tbl.copy()
    incremental_reach_df = incr_tbl.copy()
    weekly_spend_df = spend_tbl.copy()
