]

# Meta API Functions

@backoff.on_exception(backoff.expo, requests.exceptions.RequestException, max_tries=5)
def fetch_account_name(ad_account_id: str, access_token: str) -> str:
    """Fetch ad account name from Facebook API"""
    try:
        url = (
            f"https://graph.facebook.com/{FACEBOOK_GRAPH_API_VERSION}/act_{ad_account_id}"
            f"?fields=name"
            f"&access_token={access_token}"
        )
        response = requests.get(url, timeout=30)
        response.raise_for_status()
        return response.json().get('name', 'Unknown Account')
    except requests.exceptions.RequestException as e:
        print(f"Error fetching account name for act_{ad_account_id}: {str(e)}")
        return 'Unknown Account (Error)'
    except json.JSONDecodeError as e:
        print(f"Error decoding JSON response for account name (act_{ad_account_id}): {str(e)}")
        return 'Unknown Account (JSON Error)'

@backoff.on_exception(backoff.expo, requests.exceptions.RequestException, max_tries=3, jitter=backoff.full_jitter)
def fetch_insights_data(
    ad_account_id: str,
    access_token: str,
    start_date: datetime.date,
    end_date: datetime.date,
    level: str = "account",
    fields: Optional[List[str]] = None
) -> Optional[Dict]:
    """Fetch insights from Facebook API with retries"""
    if fields is None:
        fields = METRICS_TO_FETCH

    try:
        url = (
            f"https://graph.facebook.com/{FACEBOOK_GRAPH_API_VERSION}/act_{ad_account_id}/insights"
            f'?time_range={{"since":"{start_date.isoformat()}","until":"{end_date.isoformat()}"}}'
            f"&level={level}"
            f"&fields={','.join(fields)}"
            f"&access_token={access_token}"
        )
        response = requests.get(url, timeout=45)
        response.raise_for_status()
        data = response.json().get('data', [])
        return data[0] if data else {}
    except requests.exceptions.Timeout:
        print(f"API Request Timeout for act_{ad_account_id} ({start_date} to {end_date}).")
        raise
    except requests.exceptions.RequestException as e:
        print(f"API Request Error for act_{ad_account_id} ({start_date} to {end_date}): {str(e)}")
        raise
    except json.JSONDecodeError as e:
        print(f"Error decoding JSON response for insights (act_{ad_account_id}, {start_date}-{end_date}): {str(e)}")
        return {}

def get_fb_metrics_for_ad_account(
    ad_account_id: str,
    access_token: str,
    start_date_config: datetime.date,
    end_date_config: datetime.date,
    first_day_of_week_config: str
) -> List[Dict]:
    """
    Get metrics for a date range, aggregated into weekly chunks based on the configured first day of the week.
    """
    results = []
    current_date = start_date_config

    day_map = {'monday': 0, 'tuesday': 1, 'wednesday': 2, 'thursday': 3, 'friday': 4, 'saturday': 5, 'sunday': 6}
    first_day_int = day_map[first_day_of_week_config.lower()]

    print(f"Fetching weekly metrics for Ad Account: {ad_account_id}")
    print(f"Date Range: {start_date_config.isoformat()} to {end_date_config.isoformat()}")
    print(f"Aggregating weekly data with week starting on {first_day_of_week_config.capitalize()}.")

    while current_date <= end_date_config:
        end_of_week_weekday = (first_day_int - 1 + 7) % 7
        days_until_end_of_week = (end_of_week_weekday - current_date.weekday() + 7) % 7

        week_end = current_date + datetime.timedelta(days=days_until_end_of_week)

        api_week_end = min(week_end, end_date_config)

        print(f"  Processing period: {current_date.isoformat()} to {api_week_end.isoformat()}")

        try:

            weekly_metrics = fetch_insights_data(ad_account_id, access_token, current_date, api_week_end)


            cumulative_reach_data = fetch_insights_data(
                ad_account_id, access_token, start_date_config, api_week_end, fields=["reach"]
            )

            result = {
                'date': current_date.strftime('%Y-%m-%d'),
                'reach': int(weekly_metrics.get('reach', 0)),
                'reach_for_date': int(cumulative_reach_data.get('reach', 0)),
                'impressions': int(weekly_metrics.get('impressions', 0)),
                'frequency': float(weekly_metrics.get('frequency', 0.0)),
                'cpm': float(weekly_metrics.get('cpm', 0.0)),
                'spend': float(weekly_metrics.get('spend', 0.0))
            }
            results.append(result)

        except Exception as e:
            print(f"Error fetching data for period starting {current_date.isoformat()}: {str(e)}")
            print("  Adding row with zeros for this period.")
            results.append({
                'date': current_date.strftime('%Y-%m-%d'),
                'reach': 0,
                'reach_for_date': 0,
                'impressions': 0,
                'frequency': 0.0,
                'cpm': 0.0,
                'spend': 0.0
            })


        current_date = api_week_end + datetime.timedelta(days=1)

    return results

# Report Functions
def generate_reach_report_pdf(input_data_for_report: dict, output_filename: str = "weekly_incremental_reach_report.pdf"):
    """
    Processes marketing data, generates a weekly incremental reach plot,
    and saves it as a PDF.
    """
    try:
        account_name_for_report = input_data_for_report.get('account_name', 'Unknown Account')
        report_data_list = input_data_for_report.get('data')

        if not report_data_list:
            raise ValueError("Error: No 'data' list found in the input for report generation.")

        df = pd.DataFrame(report_data_list)
        if df.empty:
            raise ValueError("Error: DataFrame is empty after parsing input data for report.")

    except Exception as e:
        print(f"Error parsing initial data for report: {str(e)}")
        raise

    # Data Processing
    try:
        df['reach'] = pd.to_numeric(df['reach'], errors='coerce').fillna(0).astype(int)
        df['reach_for_date'] = pd.to_numeric(df['reach_for_date'], errors='coerce').fillna(0).astype(int)
        df['date'] = pd.to_datetime(df['date'])

        df.sort_values(by='date', inplace=True)
        df_weekly = df.copy()

        if df_weekly.empty:
            print("Warning: DataFrame for report is empty. Check input data and date range.")
            return

        df_weekly['incremental_reach'] = 0
        df_weekly['existing_reach'] = 0

        df_weekly.sort_values(by='date', inplace=True)
        df_weekly.reset_index(drop=True, inplace=True)

        for i in range(len(df_weekly)):
            current_weekly_reach = df_weekly.at[i, 'reach']
            current_cumulative_reach = df_weekly.at[i, 'reach_for_date']

            if i == 0:
                df_weekly.at[i, 'incremental_reach'] = current_cumulative_reach
                df_weekly.at[i, 'existing_reach'] = max(0, current_weekly_reach - df_weekly.at[i, 'incremental_reach'])
            else:
                prev_cumulative_reach = df_weekly.at[i-1, 'reach_for_date']
                incremental = current_cumulative_reach - prev_cumulative_reach
                df_weekly.at[i, 'incremental_reach'] = max(0, incremental)

                existing = current_weekly_reach - df_weekly.at[i, 'incremental_reach']
                df_weekly.at[i, 'existing_reach'] = max(0, existing)

        df_weekly['total_bar_height_check'] = df_weekly['incremental_reach'] + df_weekly['existing_reach']

        df_weekly['incremental_percentage'] = 0.0
        df_weekly.loc[df_weekly['reach'] > 0, 'incremental_percentage'] = \
            (df_weekly['incremental_reach'] / df_weekly['reach']) * 100
        df_weekly['incremental_percentage'].fillna(0, inplace=True)
        df_weekly['incremental_percentage'] = df_weekly['incremental_percentage'].clip(0, 100)


    except Exception as e:
        print(f"Error during data processing for report: {str(e)}")
        import traceback
        traceback.print_exc()
        raise

    if df_weekly.empty:
        print("No data to plot after processing for report.")
        return

    # Plot
    try:
        fig, ax1 = plt.subplots(figsize=(max(15, len(df_weekly) * 1.2), 9))
        ax2 = ax1.twinx()


        num_weeks = len(df_weekly['date'].unique())
        bar_width_days = 5

        bars1 = ax1.bar(df_weekly['date'], df_weekly['existing_reach'],
                        width=datetime.timedelta(days=bar_width_days), label='Previously Reached', color='#4A90E2', alpha=0.8)
        bars2 = ax1.bar(df_weekly['date'], df_weekly['incremental_reach'],
                        width=datetime.timedelta(days=bar_width_days), bottom=df_weekly['existing_reach'],
                        label='Incremental Reach', color='#7ED321', alpha=0.8)

        line = ax2.plot(df_weekly['date'], df_weekly['incremental_percentage'],
                        color='darkorange', marker='o', linestyle='-', linewidth=2, markersize=5, label='% Incremental')

        def format_k(value):
            if pd.isna(value): return ""
            return f"{value/1000:.1f}k" if abs(value) >= 1000 else str(int(value))

        for i, row in df_weekly.iterrows():
            bar_bottom_val = 0
            if row['existing_reach'] > 0.01 * (row['existing_reach'] + row['incremental_reach']):
                ax1.text(row['date'], bar_bottom_val + row['existing_reach']/2,
                         format_k(row['existing_reach']), ha='center', va='center', color='white', fontsize=7, fontweight='bold')
            bar_bottom_val += row['existing_reach']
            if row['incremental_reach'] > 0.01 * (row['existing_reach'] + row['incremental_reach']):
                ax1.text(row['date'], bar_bottom_val + row['incremental_reach']/2,
                         format_k(row['incremental_reach']), ha='center', va='center', color='white', fontsize=7, fontweight='bold')

            if row['reach'] > 0:
                 ax1.text(row['date'], row['reach'] * 1.02,
                          f"Weekly: {format_k(row['reach'])}", ha='center', va='bottom', fontsize=7, color='dimgray')

            date_str = row['date'].strftime('%m-%d')
            ax1.text(row['date'], -max(df_weekly['reach'].max(), (df_weekly['existing_reach'] + df_weekly['incremental_reach']).max())*0.08,
                     date_str, ha='center', va='top', rotation=45, fontsize=8)

            if pd.notna(row['incremental_percentage']):
                ax2.annotate(f"{row['incremental_percentage']:.0f}%",
                             (row['date'], row['incremental_percentage']),
                             xytext=(0, 10), textcoords='offset points',
                             ha='center', va='bottom',
                             bbox=dict(boxstyle="round,pad=0.3", fc='gold', alpha=0.7),
                             fontsize=8)

        ax1.set_xlabel('Start of Reporting Period', labelpad=45)
        ax1.set_ylabel('Reach Count')
        ax2.set_ylabel('% Incremental (of Weekly Reach)')


        if num_weeks <= 12:
            ax1.set_xticks(df_weekly['date'])
            ax1.set_xticklabels([d.strftime('%Y-%m-%d') for d in df_weekly['date']], rotation=45, ha="right")
        else:
            plt.xticks(rotation=45, ha="right")
        ax1.tick_params(axis='x', which='major', labelsize=8)


        max_bar_height = (df_weekly['existing_reach'] + df_weekly['incremental_reach']).max()
        max_weekly_reach = df_weekly['reach'].max()
        ax1.set_ylim(0, max(max_bar_height, max_weekly_reach) * 1.20 if not df_weekly.empty else 10)
        ax2.set_ylim(0, max(105, df_weekly['incremental_percentage'].max() * 1.15 if not df_weekly.empty and df_weekly['incremental_percentage'].max() > 0 else 105) )

        handles1, labels1 = ax1.get_legend_handles_labels()
        handles2, labels2 = ax2.get_legend_handles_labels()
        fig.legend(handles1 + handles2, labels1 + labels2, loc='upper center', ncol=3, bbox_to_anchor=(0.5, 0.98), framealpha=0.7)

        plt.title(f'Weekly Incremental Reach Analysis', pad=40, fontsize=16)
        plt.grid(True, axis='y', linestyle='--', alpha=0.6)
        plt.tight_layout(rect=[0, 0.05, 1, 0.90])

        print("\n--- Plot Preview ---")
        display(fig)

        pdf_buffer = io.BytesIO()
        with PdfPages(pdf_buffer) as pdf:
            pdf.savefig(fig, bbox_inches='tight')
        plt.close(fig)

        with open(output_filename, 'wb') as f:
            f.write(pdf_buffer.getvalue())
        print(f"\nPDF report '{output_filename}' created successfully.")
        files.download(output_filename)

    except Exception as e:
        print(f"Error generating plot or PDF: {str(e)}")
        import traceback
        traceback.print_exc()
        if 'fig' in locals() and fig: plt.close(fig)
        raise

def generate_spend_report_pdf(input_data_for_report: dict, output_filename: str = "weekly_spend_report.pdf"):
    """
    Processes marketing data, generates a weekly spend bar chart,
    and saves it as a PDF.
    """
    try:
        account_name_for_report = input_data_for_report.get('account_name', 'Unknown Account')
        report_data_list = input_data_for_report.get('data')

        if not report_data_list:
            raise ValueError("Error: No 'data' list found in the input for spend report generation.")

        df = pd.DataFrame(report_data_list)
        if df.empty:
            raise ValueError("Error: DataFrame is empty after parsing input data for spend report.")

    except Exception as e:
        print(f"Error parsing initial data for spend report: {str(e)}")
        raise

    # --- Data Processing for Spend Report ---
    try:
        df['spend'] = pd.to_numeric(df['spend'], errors='coerce').fillna(0)
        df['date'] = pd.to_datetime(df['date'])
        df.sort_values(by='date', inplace=True)
        df.reset_index(drop=True, inplace=True)

        if df.empty:
            print("Warning: DataFrame for spend report is empty. Check input data and date range.")
            return

        # Calculate additional metrics
        total_spend = df['spend'].sum()
        avg_weekly_spend = df['spend'].mean() if not df.empty else 0
        max_weekly_spend = df['spend'].max()
        weeks_with_spend = (df['spend'] > 0).sum()

        # Calculate cumulative spend
        df['cumulative_spend'] = df['spend'].cumsum()

    except Exception as e:
        print(f"Error during data processing for spend report: {str(e)}")
        import traceback
        traceback.print_exc()
        raise

    if df.empty:
        print("No data to plot after processing for spend report.")
        return

    # Plot
    try:
        fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(max(15, len(df) * 1.2), 12))


        num_weeks = len(df['date'].unique())
        bar_width_days = 5


        bars = ax1.bar(df['date'], df['spend'],
                      width=datetime.timedelta(days=bar_width_days),
                      color='#E74C3C', alpha=0.8, edgecolor='darkred', linewidth=1)


        fmt = '${x:,.0f}'
        tick = mtick.StrMethodFormatter(fmt)
        ax1.yaxis.set_major_formatter(tick)


        for i, (bar, value) in enumerate(zip(bars, df['spend'])):
            if value > 0:
                if value >= 1000:
                    spend_label = f'${value:,.0f}'
                else:
                    spend_label = f'${value:.2f}'

                ax1.text(bar.get_x() + bar.get_width()/2, bar.get_height() + max(df['spend'].max(), 1) * 0.01,
                        spend_label, ha='center', va='bottom', fontweight='bold', fontsize=8)


                date_str = df.iloc[i]['date'].strftime('%m-%d')
                ax1.text(bar.get_x() + bar.get_width()/2, -max(df['spend'].max(), 1) * 0.05,
                        date_str, ha='center', va='top', rotation=45, fontsize=8)

        ax1.set_title(f'{account_name_for_report} - Weekly Ad Spend', fontsize=14, fontweight='bold', pad=20)
        ax1.set_ylabel('Weekly Spend ($)', fontweight='bold')
        ax1.grid(True, axis='y', linestyle='--', alpha=0.6)


        max_spend = df['spend'].max()
        ax1.set_ylim(0, max_spend * 1.15 if max_spend > 0 else 100)


        if num_weeks <= 12:
            ax1.set_xticks(df['date'])
            ax1.set_xticklabels([d.strftime('%Y-%m-%d') for d in df['date']], rotation=45, ha="right")
        else:
            ax1.tick_params(axis='x', rotation=45)


        ax2.plot(df['date'], df['cumulative_spend'],
                color='#2E86AB', marker='o', linewidth=3, markersize=6, alpha=0.8)
        ax2.fill_between(df['date'], df['cumulative_spend'], alpha=0.3, color='#2E86AB')


        ax2.yaxis.set_major_formatter(tick)


        for i, row in df.iterrows():
            if i % max(1, len(df) // 8) == 0 or i == len(df) - 1:
                cum_spend_label = f'${row["cumulative_spend"]:,.0f}'
                ax2.annotate(cum_spend_label,
                           (row['date'], row['cumulative_spend']),
                           xytext=(0, 10), textcoords='offset points',
                           ha='center', va='bottom',
                           bbox=dict(boxstyle="round,pad=0.3", fc='lightblue', alpha=0.7),
                           fontsize=8)

        ax2.set_title('Cumulative Ad Spend', fontsize=14, fontweight='bold')
        ax2.set_xlabel('Reporting Period Start Date', fontweight='bold')
        ax2.set_ylabel('Cumulative Spend ($)', fontweight='bold')
        ax2.grid(True, linestyle='--', alpha=0.6)


        if num_weeks <= 12:
            ax2.set_xticks(df['date'])
            ax2.set_xticklabels([d.strftime('%Y-%m-%d') for d in df['date']], rotation=45, ha="right")
        else:
            ax2.tick_params(axis='x', rotation=45)


        stats_text = f"""Summary Statistics:
Total Spend: ${total_spend:,.2f}
Average Period Spend: ${avg_weekly_spend:,.2f}
Highest Period Spend: ${max_weekly_spend:,.2f}
Periods with Spend: {weeks_with_spend}"""

        ax2.text(0.02, 0.98, stats_text, transform=ax2.transAxes, fontsize=10,
                verticalalignment='top', bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.8))

        plt.tight_layout()

        print("\n--- Spend Report Plot Preview ---")
        display(fig)

        # Save to PDF
        pdf_buffer = io.BytesIO()
        with PdfPages(pdf_buffer) as pdf:
            pdf.savefig(fig, bbox_inches='tight')
        plt.close(fig)

        with open(output_filename, 'wb') as f:
            f.write(pdf_buffer.getvalue())
        print(f"\nSpend PDF report '{output_filename}' created successfully.")
        files.download(output_filename)

    except Exception as e:
        print(f"Error generating spend plot or PDF: {str(e)}")
        import traceback
        traceback.print_exc()
        if 'fig' in locals() and fig: plt.close(fig)
        raise

